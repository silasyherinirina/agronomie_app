# URL de base de l'API Laravel (jamais d'accès direct à PostgreSQL depuis le frontend)
# IMPORTANT : utiliser "localhost", jamais "127.0.0.1". Les cookies Sanctum (session +
# XSRF-TOKEN) sont posés avec Domain=localhost (SESSION_DOMAIN côté backend) ; un navigateur
# ne les envoie pas vers 127.0.0.1, même si ça pointe vers la même machine (vérifié Phase 4).
# Le frontend doit donc aussi être ouvert via http://localhost:5173, pas 127.0.0.1:5173.
VITE_API_BASE_URL=http://localhost:8000

# Coordonnées par défaut de la carte (Madagascar) — à ajuster si besoin
VITE_MAP_DEFAULT_LAT=-18.8792
VITE_MAP_DEFAULT_LNG=47.5079
VITE_MAP_DEFAULT_ZOOM=6
