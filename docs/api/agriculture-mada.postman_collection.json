              "query": [{ "key": "per_page", "value": "15" }, { "key": "crop_cycle_id", "value": "" }] }
          }
        },
        {
          "name": "Create harvest — rendement calculé",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"crop_cycle_id\": {{crop_cycle_id}},\n  \"harvest_date\": \"2026-08-20\",\n  \"quantity\": 2500,\n  \"unit\": \"kg\",\n  \"yield_source\": \"calculated\",\n  \"quality\": \"bonne\",\n  \"observations\": \"Récolte dans de bonnes conditions.\"\n}" },
            "url": { "raw": "{{base_url}}/api/harvests", "host": ["{{base_url}}"], "path": ["api", "harvests"] },
            "description": "yield_source=calculated : yield_value = quantity / plot.area_ha, calculé automatiquement."
          }
        },
        {
          "name": "Create harvest — rendement déclaré",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"crop_cycle_id\": {{crop_cycle_id}},\n  \"harvest_date\": \"2026-08-20\",\n  \"quantity\": 2500,\n  \"unit\": \"kg\",\n  \"yield_source\": \"declared\",\n  \"yield_value\": 3000\n}" },
            "url": { "raw": "{{base_url}}/api/harvests", "host": ["{{base_url}}"], "path": ["api", "harvests"] },
            "description": "yield_source=declared : yield_value obligatoire, saisi tel quel."
          }
        },
        {
          "name": "Show harvest",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
