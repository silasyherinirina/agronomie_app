            "url": {
              "raw": "{{base_url}}/api/cooperatives?per_page=15&search=&region=&status=",
              "host": ["{{base_url}}"], "path": ["api", "cooperatives"],
              "query": [
                { "key": "per_page", "value": "15" },
                { "key": "search", "value": "", "description": "Recherche partielle sur le nom" },
                { "key": "region", "value": "" },
                { "key": "status", "value": "", "description": "active | inactive" }
              ]
            }
          }
        },
        {
          "name": "Create cooperative (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Coopérative Vontovorona\",\n  \"region\": \"Analamanga\",\n  \"district\": \"Antananarivo Atsimondrano\",\n  \"commune\": \"Vontovorona\",\n  \"geometry\": { \"type\": \"Point\", \"coordinates\": [47.5079, -18.9333] },\n  \"manager_user_id\": null,\n  \"status\": \"active\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/cooperatives", "host": ["{{base_url}}"], "path": ["api", "cooperatives"] },
            "description": "geometry : GeoJSON Point [longitude, latitude], SRID 4326. Réservé à l'administrateur."
          }
        },
        {
          "name": "Show cooperative",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/cooperatives/{{cooperative_id}}", "host": ["{{base_url}}"], "path": ["api", "cooperatives", "{{cooperative_id}}"] }
          }
        },
        {
          "name": "Update cooperative",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"active\"\n}" },
            "url": { "raw": "{{base_url}}/api/cooperatives/{{cooperative_id}}", "host": ["{{base_url}}"], "path": ["api", "cooperatives", "{{cooperative_id}}"] },
            "description": "Administrateur : tous champs. Responsable de coopérative : uniquement sa propre coopérative."
          }
        },
        {
          "name": "Delete cooperative (admin)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/cooperatives/{{cooperative_id}}", "host": ["{{base_url}}"], "path": ["api", "cooperatives", "{{cooperative_id}}"] },
            "description": "Suppression contrôlée (soft delete)."
          }
        }
      ]
    },
