{
  "info": {
    "name": "Agriculture Mada API",
    "description": "Plateforme intelligente de gestion agricole pour les coopératives agricoles à Madagascar — API REST Laravel 13 (Phase 3-4 du mémoire M2). Authentification SPA Sanctum (cookie httpOnly + CSRF).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Injecte automatiquement le jeton CSRF (cookie XSRF-TOKEN posé par",
          "// GET /sanctum/csrf-cookie) dans l'en-tête X-XSRF-TOKEN, comme le ferait Axios",
          "// côté frontend React. Nécessite que Postman gère les cookies (activé par défaut).",
          "if (pm.cookies.has('XSRF-TOKEN')) {",
          "    pm.request.headers.upsert({",
          "        key: 'X-XSRF-TOKEN',",
          "        value: decodeURIComponent(pm.cookies.get('XSRF-TOKEN'))",
          "    });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "cooperative_id", "value": "1", "type": "string" },
    { "key": "farmer_id", "value": "1", "type": "string" },
    { "key": "plot_id", "value": "1", "type": "string" },
    { "key": "crop_id", "value": "1", "type": "string" },
    { "key": "crop_variety_id", "value": "1", "type": "string" },
    { "key": "campaign_id", "value": "1", "type": "string" },
    { "key": "crop_cycle_id", "value": "1", "type": "string" },
    { "key": "harvest_id", "value": "1", "type": "string" },
    { "key": "input_id", "value": "1", "type": "string" },
    { "key": "input_usage_id", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "0. Get CSRF cookie",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/sanctum/csrf-cookie", "host": ["{{base_url}}"], "path": ["sanctum", "csrf-cookie"] },
            "description": "À appeler une fois avant login. Pose le cookie XSRF-TOKEN utilisé par le script de pré-requête de la collection."
          }
        },
        {
          "name": "1. Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/login", "host": ["{{base_url}}"], "path": ["api", "login"] },
            "description": "Crée la session (cookie httpOnly). Réponse : utilisateur authentifié + rôle."
          }
        },
        {
          "name": "2. Current user",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/user", "host": ["{{base_url}}"], "path": ["api", "user"] }
          }
        },
        {
          "name": "3. Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/logout", "host": ["{{base_url}}"], "path": ["api", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Dashboard (Module H)",
      "item": [
        {
          "name": "Get dashboard summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{base_url}}/api/dashboard?cooperative_id=&campaign_id=",
              "host": ["{{base_url}}"], "path": ["api", "dashboard"],
              "query": [
                { "key": "cooperative_id", "value": "", "description": "Ignoré pour cooperative_manager/farmer (périmètre forcé côté serveur)" },
                { "key": "campaign_id", "value": "" }
              ]
            },
            "description": "KPIs, totaux de récolte par unité (jamais sommés entre unités différentes), rendement moyen, production/rendement par culture, évolution par campagne, consommation d'intrants, répartition géographique. Périmètre des données selon le rôle du compte connecté."
          }
        }
      ]
    },
    {
      "name": "Cooperatives (Module A)",
      "item": [
