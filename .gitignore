# Frontend (React + Vite)
# ================================
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.*.local
frontend/*.local
frontend/coverage/

# ================================
# AI Service (FastAPI / Python)
# ================================
ai-service/venv/
ai-service/.venv/
ai-service/__pycache__/
ai-service/**/__pycache__/
ai-service/*.pyc
ai-service/.env
ai-service/models/*.joblib
ai-service/models/*.pkl
# Registre de modèles entraînés (Phase 8+, un sous-dossier par modèle : metadata.json +
# model.joblib) — artefacts générés localement, jamais versionnés.
ai-service/models/*/
ai-service/data/raw/
ai-service/.pytest_cache/

